{
  "name": "werewolf",
  "private": true,
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@werewolf/server --filter=@werewolf/web",
    "dev:server": "turbo run dev --filter=@werewolf/server",
    "dev:web": "turbo run dev --filter=@werewolf/web",
    "dev:mobile": "pnpm --filter @werewolf/mobile start",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@vitest/coverage-v8": "^5.1.0",
    "turbo": "^2.11.12",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
